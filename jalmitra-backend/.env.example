# Copy to .env and fill in real values. Never commit .env.

APP_NAME=JalMitra
# Set to false in production (hides debug_otp, stops printing OTPs)
DEBUG=true

# PostgreSQL — local or Supabase (postgresql+asyncpg:// scheme)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/jalmitra

# MQTT broker — use port 8883 for TLS / cloud brokers
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Shared key the field device / simulator sends as X-Device-Key.
# Leave empty to skip the check during local development.
DEVICE_API_KEY=

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
